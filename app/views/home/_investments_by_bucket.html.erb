<%# Definição do mapa de cores na mesma ordem do gráfico %>
<% bucket_colors = ['#FF9900', '#CC6699', '#9999FF', '#FFCC00', '#3399FF'] %>

<div class="lcars-content h-100">
  <div class="lcars-subtitle">
    <%= t('home.charts.investments_by_bucket') %>
    <%= link_to t('buttons.investments'),
        investments_path,
        data: { turbo_frame: "_top" },
        class: "lcars-button lcars-button--secondary" %>
  </div>

  <div class="charts-container charts-container--2col align-items-center">
    <%# Coluna do Gráfico de Rosca %>
    <div class="chart">
      <%= pie_chart investments_by_bucket.transform_values { |data| data[:total_current] },
                    precision: 2,
                    legend: 'bottom',
                    colors: bucket_colors,
                    library: {
                      chartArea: { backgroundColor: 'transparent' },
                      backgroundColor: 'transparent',
                      legend: { textStyle: { color: '#FFFFFF', fontSize: 12 } }
                    } %>
    </div>

    <%# Coluna das Carteiras / Buckets %>
    <div class="buckets-summary">
      <% investments_by_bucket.each_with_index do |(bucket_name, data), index| %>
        <% color = bucket_colors[index % bucket_colors.length] %>

        <div class="bucket-card mb-3" style="border-left: 4px solid <%= color %>; padding-left: 10px;">
          <%# Título na cor correspondente do gráfico %>
          <h4 class="bucket-title" style="color: <%= color %>; margin-bottom: 4px;">
            <%= bucket_name %>
          </h4>

          <div class="bucket-details">
            <small class="text-muted">Aporte: <%= number_to_currency(data[:total_invested]) %></small><br>
            <strong>Atual: <%= number_to_currency(data[:total_current]) %></strong>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
