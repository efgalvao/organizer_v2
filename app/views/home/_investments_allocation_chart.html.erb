<div class="lcars-content h-100">
  <div class="lcars-subtitle">
    <%= t('home.charts.investments_allocation') %>
    <%= link_to t('buttons.investments'),
        investments_path,
        data: { turbo_frame: "_top" },
        class: "lcars-button lcars-button--secondary" %>
  </div>

  <div class="charts-container">
    <div class="chart">
      <%= pie_chart investments_allocation,
                    precision: 2,
                    legend: 'bottom',
                    colors: ['#3399FF', '#FF9900', '#CC6699', '#9999FF', '#FFCC00'],
                    library: {
                      chartArea: { backgroundColor: 'transparent' },
                      backgroundColor: 'transparent',
                      legend: { textStyle: { color: '#FFFFFF', fontSize: 12 } }
                    } %>
    </div>
  </div>
</div>
