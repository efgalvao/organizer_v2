<div class="lcars-container h-100">
  <div class="lcars-list">
    <div class="lcars-subtitle" style="margin-bottom: 1rem;">
      <%= t('home.portfolio.allocations.title') %>
      <%= link_to t('home.portfolio.allocations.manage_targets'),
                  portfolio_targets_path,
                  data: { turbo_frame: "_top" },
                  class: "lcars-button lcars-button--secondary" %>
    </div>

    <%= turbo_frame_tag "allocations_list" do %>
      <% if portfolio_summary[:classes].any? %>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <% portfolio_summary[:classes].each do |cls| %>
            <% real_pct = [cls[:real_percentage].to_f, 100.0].min %>
            <% target_pct = [cls[:target_percentage].to_f, 100.0].min %>

            <div>
              <%# Cabeçalho da linha %>
              <div style="display: flex; justify-content: space-between; align-items: center; color: #FFFFFF; font-size: 0.85rem; margin-bottom: 0.3rem;">
                <strong style="color: #FF9900;"><%= cls[:kind_human] %></strong>
                <span>
                  Atual: <strong style="color: #3399FF;"><%= cls[:real_percentage] %>%</strong> |
                  Meta: <strong style="color: #CC6699;"><%= cls[:target_percentage] %>%</strong>
                </span>
              </div>

              <%# Trilho da Barra (Background escuro) %>
              <div style="position: relative; width: 100%; height: 16px; background-color: #1a1a1a; border-radius: 8px; border: 1px solid #333333; overflow: hidden;">

                <%# Preenchimento do Percentual Atual (Azul) %>
                <div style="width: <%= real_pct %>%; height: 100%; background-color: #3399FF; transition: width 0.3s ease;"></div>

                <%# Linha da Meta (Marcador Rosa/Magenta) %>
                <div style="position: absolute; top: 0; bottom: 0; left: <%= target_pct %>%; width: 4px; background-color: #CC6699; box-shadow: 0 0 6px #CC6699; transform: translateX(-50%); z-index: 10;"
                     title="Meta: <%= cls[:target_percentage] %>%">
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div style="text-align: center; padding: 2rem;">
          <p style="color: #888888;"><%= t('home.portfolio.allocations.empty') %></p>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
