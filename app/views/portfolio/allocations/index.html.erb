<div class="lcars-container">
  <%= turbo_frame_tag "allocations_header" do %>
    <div class="lcars-header lcars-header--section flex justify-between items-center">
      <h1><%= t('portfolio.allocations.index.title', default: 'Alocação por Classe de Ativo') %></h1>

      <div class="lcars-actions">
        <%= link_to t('portfolio.allocations.index.manage_targets', default: 'Gerenciar Metas'),
                    portfolio_targets_path,
                    class: "lcars-button lcars-button--secondary",
                    data: { turbo_frame: "_top" } %>
      </div>
    </div>
  <% end %>

  <div class="lcars-list">
    <div class="lcars-table-container">
      <table class="lcars-table">
        <thead>
          <tr>
            <th>
              <%= t('portfolio.allocations.index.kind', default: 'Classe de Ativo') %>
            </th>

            <th>
              <%= t('portfolio.allocations.index.total_value', default: 'Posição Atual') %>
            </th>

            <th>
              <%= t('portfolio.allocations.index.real_percentage', default: '% Atual') %>
            </th>

            <th>
              <%= t('portfolio.allocations.index.target_percentage', default: '% Meta') %>
            </th>

            <th>
              <%= t('portfolio.allocations.index.deviation', default: 'Desvio') %>
            </th>
          </tr>
        </thead>

        <%= turbo_frame_tag "allocations_list" do %>
          <tbody>
            <% if @portfolio_summary[:classes].any? %>
              <% @portfolio_summary[:classes].each do |cls| %>
                <tr>
                  <td>
                    <%= cls[:kind_human] %>
                  </td>

                  <td>
                    <%= number_to_currency(cls[:total_value], unit: "R$ ", separator: ",", delimiter: ".") %>
                  </td>

                  <td>
                    <%= cls[:real_percentage] %>%
                  </td>

                  <td>
                    <%= cls[:target_percentage] %>%
                  </td>

                  <td>
                    <% deviation = cls[:deviation] %>
                    <% if deviation.zero? %>
                      <span class="lcars-badge lcars-badge--neutral">
                        0.0%
                      </span>
                    <% elsif deviation < 0 %>
                      <span class="lcars-badge lcars-badge--warning">
                        <%= deviation %>%
                      </span>
                    <% else %>
                      <span class="lcars-badge lcars-badge--info">
                        +<%= deviation %>%
                      </span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="text-center">
                  <%= t('portfolio.allocations.index.empty', default: 'Nenhuma classe ou meta encontrada.') %>
                </td>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  </div>
</div>
