<div class="lcars-container">
  <%# Cabeçalho LCARS estilo painel %>
  <div class="lcars-header lcars-header--section">
    <h1><%= t('portfolio.targets.form.title', default: 'Definir Metas de Alocação') %></h1>
  </div>

  <%= simple_form_for :targets,
                      url: portfolio_targets_path,
                      method: :post,
                      html: { class: "lcars-form" } do |f| %>

    <% if flash[:alert].present? %>
      <div class="lcars-alert lcars-alert--danger margin-bottom-md">
        <p><%= flash[:alert] %></p>
      </div>
    <% end %>

    <%# Grid em 2 colunas para distribuir bem as classes de ativos %>
    <div class="lcars-grid lcars-grid--2-cols">
      <% @kinds.each do |kind_key| %>
        <% target = @existing_targets[kind_key] %>
        <% current_val = target&.target_percentage || 0.0 %>

        <div class="lcars-field-group">
          <%= f.input "kind_#{kind_key}",
                      label: I18n.t("activerecord.attributes.investments/investment.kinds.#{kind_key}", default: kind_key.humanize),
                      required: false,
                      input_html: {
                        name: "targets[#{kind_key}]",
                        value: current_val,
                        type: 'number',
                        step: '0.01',
                        min: '0',
                        max: '100',
                        class: 'lcars-input'
                      } %>
        </div>
      <% end %>
    </div>

    <%# Botões na parte inferior da tela, bem alinhados %>
    <div class="lcars-actions-row margin-top-lg">
      <%= f.submit t('buttons.save', default: 'Salvar'), class: "lcars-button lcars-button--secondary" %>
      <%= link_to t('buttons.cancel', default: 'Cancelar'), portfolio_allocations_path, class: "lcars-button lcars-button--danger" %>
    </div>
  <% end %>
</div>
